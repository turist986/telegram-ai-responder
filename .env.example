# Telegram API credentials — получить на https://my.telegram.org
TELEGRAM_API_ID=123456
TELEGRAM_API_HASH=your_api_hash_here

# Ключи ИИ-провайдеров — заполните только тот, который собираетесь
# использовать (выбирается в панели «Настройки» → «Нейросеть», по
# умолчанию активен DeepSeek). Остальные можно оставить пустыми/удалить.
DEEPSEEK_API_KEY=sk-xxxxxxxx
# OPENAI_API_KEY=sk-xxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# GROQ_API_KEY=gsk_xxxxxxxx
# MISTRAL_API_KEY=xxxxxxxx
# OPENROUTER_API_KEY=sk-or-xxxxxxxx

# Веб-панель: логин/пароль администратора
ADMIN_USERNAME=admin
# Получить: python scripts/hash_password.py
ADMIN_PASSWORD_HASH=replace_with_output_of_scripts_hash_password
# Длинная случайная строка (например: python -c "import secrets;print(secrets.token_hex(32))")
SECRET_KEY=replace_with_a_long_random_string

# Значения дисклеймера по умолчанию (если не заданы в managers.xlsx) — впишите своё название компании
DEFAULT_MANAGER_NAME=Служба поддержки
DEFAULT_DISCLAIMER_TEMPLATE=Ответ сгенерирован ИИ-ассистентом менеджера {name}.
DEFAULT_FALLBACK_DISCLAIMER=Ответ сгенерирован ИИ-ассистентом.

# Поведение
HISTORY_LIMIT=12
TYPING_DELAY_MIN=2.0
TYPING_DELAY_MAX=6.0
RECONCILE_INTERVAL_SECONDS=5

# По умолчанию используется data/app.db внутри проекта (путь считается от
# расположения кода, а не от текущей директории запуска — безопасно для
# systemd/--app-dir). Раскомментируйте и задайте свой путь, только если
# нужна отдельная БД (например, PostgreSQL) — используйте АБСОЛЮТНЫЙ путь,
# если это всё же SQLite, иначе относительный путь будет зависеть от того,
# откуда запущен процесс.
# DATABASE_URL=postgresql+psycopg://user:pass@localhost/ai_responder
